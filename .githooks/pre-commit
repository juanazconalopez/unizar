#!/bin/sh
set -e

# Los clientes gráficos de Git pueden no cargar nvm al abrirse.
case "$(node --version 2>/dev/null)" in
  v24.*) ;;
  *)
    # /bin/sh no permite a nvm deducir de forma fiable la carpeta del script.
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [ -s "$NVM_DIR/nvm.sh" ]; then
      if ! . "$NVM_DIR/nvm.sh"; then
        echo 'No se ha podido cargar nvm para preparar el commit.' >&2
        exit 1
      fi
      if ! nvm use --silent >/dev/null; then
        echo 'No se ha podido activar Node.js para el commit. Ejecuta nvm install y nvm use en este proyecto.' >&2
        exit 1
      fi
    fi
    ;;
esac

exec node scripts/commitVersion.ts "$@"
